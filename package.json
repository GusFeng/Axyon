{
  "name": "axyon",
  "version": "3.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run build && npm run typecheck && npm test && npm run check:boundaries",
    "start": "node dist/bot.js",
    "inventory": "node dist/tools/inventory.js",
    "check:boundaries": "node tools/check-boundaries.cjs"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "dependencies": {
    "discord.js": "14.18.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
