# Never commit real credentials. Single authorized guild is required.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
AXYON_REGISTER_COMMANDS=false
DISCORD_MESSAGE_CONTENT=false
DISCORD_GUILD_MEMBERS=false
AXYON_ENABLE_DMS=false
# Leave empty for ephemeral development; mount a writable persistent volume before using a file.
AXYON_DB_PATH=
PORT=3000
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_FORMAT=openai

# Startup connectivity probe and one-time controlled test switches (off by default).
AI_STARTUP_CHECK=false
AXYON_LIVE_SMOKE=false
AXYON_CLEAN_LEGACY_GLOBAL_COMMANDS=false

# Optional OpenAI-compatible SSE (responses are released after authorization).
AI_STREAMING=false
# One startup-only read-only comparison; turn off after validation.
AXYON_PERFORMANCE_CHECK=false

# Isolated staging profile (only set for a separate test application/guild).
# AXYON_ENVIRONMENT=staging
# AXYON_STAGING_APPLICATION_ID=
# AXYON_PRODUCTION_APPLICATION_ID=
# AXYON_PRODUCTION_GUILD_ID=
